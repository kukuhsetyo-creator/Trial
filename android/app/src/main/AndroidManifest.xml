<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Pencadangan dimatikan, bukan sekadar disaring.

      Aplikasi ini menyimpan nama peserta beserta pola jawaban, skor mentah,
      skor deviasi, dan klasifikasi inteligensinya pada localStorage WebView.
      Dengan targetSdkVersion 34 dan allowBackup bernilai true, Android Auto
      Backup menyalin isi itu ke Google Drive milik pemakai secara berkala —
      diam-diam membatalkan jaminan yang dinyatakan aplikasi ini sendiri bahwa
      data peserta tidak meninggalkan perangkat. Pada perangkat di bawah
      Android 9 cadangan tersebut bahkan tidak terenkripsi ujung-ke-ujung
      dengan PIN perangkat, sehingga perlindungannya semata bergantung pada
      keamanan akun Google.

      Konsekuensinya perlu diketahui: data koreksi tidak ikut berpindah ketika
      pemakai berganti ponsel. Untuk data asesmen psikologis, kehilangan itu
      jauh lebih ringan daripada penyalinan yang tidak disadari.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!--
      INTERNET dibutuhkan Capacitor untuk melayani aset dari server lokal di
      dalam WebView, bukan untuk menghubungi layanan mana pun. Aplikasi ini
      tidak pernah memanggil alamat di luar perangkat.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Pengambilan citra LJK langsung dari kamera perangkat. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      Ekspor PDF dan CSV ditulis ke folder Documents. Sejak API 30 penulisan itu
      tidak lagi menuntut izin, tetapi minSdkVersion proyek ini adalah 22: pada
      perangkat API 22-29 plugin Filesystem menolak menulis bila izin tulis
      tidak dideklarasikan, sehingga seluruh ekspor gagal.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
</manifest>
