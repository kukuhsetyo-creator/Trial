<html>
<body style="font-size:9pt; color:#1F1F1F;">
<h1 style="font-size:18pt;">{{ title }}</h1>
<p style="color:#7A7A7A;">{{ generated }}</p>

<h2 style="font-size:13pt;">{{ labels.meta }}</h2>
<table border="1" cellspacing="0" cellpadding="3" width="100%" style="border-color:#BDBDBD;">
{% for label, value in meta %}<tr><td width="35%" bgcolor="#F2F2F2"><b>{{ label }}</b></td><td>{{ value }}</td></tr>
{% endfor %}</table>

{% if cautions %}
<h2 style="font-size:13pt;">{{ labels.cautions }}</h2>
<table border="1" cellspacing="0" cellpadding="4" width="100%"><tr><td bgcolor="#FFF7D6">
{% for c in cautions %}• {{ c }}<br>{% endfor %}
</td></tr></table>
{% endif %}

<h2 style="font-size:13pt;">{{ labels.summary }}</h2>
<table border="1" cellspacing="0" cellpadding="4" width="100%">
<tr>{% for h in lights_head %}<th bgcolor="#E6E6E6" align="left">{{ h }}</th>{% endfor %}</tr>
{% for lt in lights %}<tr>
<td width="24%"><span style="color:{{ colors[lt.status] }}; font-size:12pt;">&#9679;</span> <b>{{ lt.title }}</b></td>
<td width="12%">{{ status_text[lt.status] }}</td>
<td>{{ lt.sentence }}</td></tr>
{% endfor %}</table>

<h2 style="font-size:13pt; page-break-before:always;">{{ labels.explanation }}</h2>
{% for p in intro %}<p>{{ p }}</p>{% endfor %}
{% for sec in sections %}
<h3 style="font-size:11pt;"><span style="color:{{ colors[sec.status] }};">&#9679;</span> {{ sec.title }}</h3>
{% for p in sec.paragraphs %}<p>{{ p }}</p>{% endfor %}
{% if sec.actions %}<p><b>{{ labels.actions }}</b></p><ul>{% for a in sec.actions %}<li>{{ a }}</li>{% endfor %}</ul>{% endif %}
{% if sec.technical %}<p><b>{{ labels.technical }}</b></p>
<table border="1" cellspacing="0" cellpadding="2" width="100%" style="font-size:8pt;">
<tr>{% for h in tech_head %}<th bgcolor="#E6E6E6" align="left">{{ h }}</th>{% endfor %}</tr>
{% for t in sec.technical %}<tr><td>{{ t.label.strip() }}</td><td>{{ t.value }}</td><td>{{ t.criterion }}</td></tr>
{% endfor %}</table>
{% if sec.references %}<p style="font-size:8pt; color:#4D4D4D;">{{ labels.references }}: {% for r in sec.references %}{{ r }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
{% endif %}
{% endfor %}

<h2 style="font-size:13pt; page-break-before:always;">{{ labels.charts }}</h2>
<p style="color:#4D4D4D;">{{ per_item_note }}</p>
{% for ch in charts %}
<h3 style="font-size:11pt;{% if not loop.first %} page-break-before:always;{% endif %}">{{ ch.title }}</h3>
<p align="center"><img src="{{ ch.src }}" width="{{ ch.width }}"></p>
<table border="0" cellspacing="0" cellpadding="6" width="100%"><tr><td bgcolor="#F2F2F2">
<b>{{ labels.how_to_read }}.</b> {{ ch.how_to_read }}</td></tr></table>
{% endfor %}

<h2 style="font-size:13pt; page-break-before:always;">{{ labels.tables }}</h2>
<p style="color:#4D4D4D;">{{ labels.table_hint }}</p>
{% for tb in tables %}
<h3 style="font-size:11pt;">{{ tb.title }}</h3>
{% if tb.note %}<p style="color:#4D4D4D;">{{ tb.note }}</p>{% endif %}
{% if tb.rows %}<table border="1" cellspacing="0" cellpadding="2" width="100%" style="font-size:7pt;">
<tr>{% for h in tb.headers %}<th bgcolor="#E6E6E6" align="left">{{ h }}</th>{% endfor %}</tr>
{% for row in tb.rows %}<tr>{% for cell in row.cells %}<td{% if row.flag %} bgcolor="#FBE3D6"{% elif row.muted %} bgcolor="#F2F2F2"{% endif %}{% if row.numeric[loop.index0] %} align="right"{% endif %}>{{ cell }}</td>{% endfor %}</tr>
{% endfor %}</table>
{% else %}<p style="color:#4D4D4D;">{{ labels.no_rows }}</p>{% endif %}
{% endfor %}

<h2 style="font-size:13pt; page-break-before:always;">{{ labels.glossary }}</h2>
{% for t in glossary %}<p><b>{{ t.term }}</b><br>{{ t.long }}</p>{% endfor %}
<p style="color:#7A7A7A;">{{ app }} {{ version }}</p>
</body>
</html>
