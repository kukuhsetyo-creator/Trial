<html>
<body style="font-size:9pt; color:{{ t.INK }};">
<table border="0" cellspacing="0" cellpadding="14" width="100%"><tr><td bgcolor="{{ t.NAVY }}">
<p style="color:{{ t.SAND_ON_NAVY }}; font-size:8pt; font-weight:600; letter-spacing:3px;">{{ app|upper }}</p>
<p style="font-family:Georgia, 'DejaVu Serif', serif; font-size:22pt; color:{{ t.NAVY_TEXT }};">{{ title }}</p>
<p style="color:#D8CCBC;">{{ generated }}</p>
</td></tr></table>

<h2 style="font-family:Georgia, 'DejaVu Serif', serif; font-weight:normal; letter-spacing:1px; color:{{ t.INK }}; font-size:14pt;">{{ labels.meta }}</h2>
<table border="1" cellspacing="0" cellpadding="3" width="100%" style="border-color:{{ t.LINE_STRONG }};">
{% for label, value in meta %}<tr><td width="35%" bgcolor="{{ t.MUTED_ROW }}"><b>{{ label }}</b></td><td>{{ value }}</td></tr>
{% endfor %}</table>

{% if cautions %}
<h2 style="font-family:Georgia, 'DejaVu Serif', serif; font-weight:normal; letter-spacing:1px; color:{{ t.INK }}; font-size:14pt;">{{ labels.cautions }}</h2>
<table border="1" cellspacing="0" cellpadding="4" width="100%"><tr><td bgcolor="{{ t.BANNER['warning'][0] }}">
{% for c in cautions %}• {{ c }}<br>{% endfor %}
</td></tr></table>
{% endif %}

<h2 style="font-family:Georgia, 'DejaVu Serif', serif; font-weight:normal; letter-spacing:1px; color:{{ t.INK }}; font-size:14pt;">{{ labels.summary }}</h2>
<table border="1" cellspacing="0" cellpadding="4" width="100%">
<tr>{% for h in lights_head %}<th bgcolor="{{ t.SAND }}" align="left">{{ h }}</th>{% endfor %}</tr>
{% for lt in lights %}<tr>
<td width="24%"><span style="color:{{ colors[lt.status] }}; font-size:12pt;">&#9679;</span> <b>{{ lt.title }}</b></td>
<td width="12%">{{ status_text[lt.status] }}</td>
<td>{{ lt.sentence }}</td></tr>
{% endfor %}</table>

<h2 style="font-family:Georgia, 'DejaVu Serif', serif; font-weight:normal; letter-spacing:1px; color:{{ t.INK }}; font-size:14pt; page-break-before:always;">{{ labels.explanation }}</h2>
{% for p in intro %}<p>{{ p }}</p>{% endfor %}
{% for sec in sections %}
<h3 style="font-size:11pt; color:{{ t.INK }};"><span style="color:{{ colors[sec.status] }};">&#9679;</span> {{ sec.title }}</h3>
{% for p in sec.paragraphs %}<p>{{ p }}</p>{% endfor %}
{% if sec.actions %}<p><b>{{ labels.actions }}</b></p><ul>{% for a in sec.actions %}<li>{{ a }}</li>{% endfor %}</ul>{% endif %}
{% if sec.technical %}<p><b>{{ labels.technical }}</b></p>
<table border="1" cellspacing="0" cellpadding="2" width="100%" style="font-size:8pt;">
<tr>{% for h in tech_head %}<th bgcolor="{{ t.SAND }}" align="left">{{ h }}</th>{% endfor %}</tr>
{% for row in sec.technical %}<tr><td>{{ row.label.strip() }}</td><td>{{ row.value }}</td><td>{{ row.criterion }}</td></tr>
{% endfor %}</table>
{% if sec.references %}<p style="font-size:8pt; color:{{ t.INK_SECONDARY }};">{{ labels.references }}: {% for r in sec.references %}{{ r }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
{% endif %}
{% endfor %}

<h2 style="font-family:Georgia, 'DejaVu Serif', serif; font-weight:normal; letter-spacing:1px; color:{{ t.INK }}; font-size:14pt; page-break-before:always;">{{ labels.charts }}</h2>
<p style="color:{{ t.INK_SECONDARY }};">{{ per_item_note }}</p>
{% for ch in charts %}
<h3 style="font-size:11pt; color:{{ t.INK }};{% if not loop.first %} page-break-before:always;{% endif %}">{{ ch.title }}</h3>
<p align="center"><img src="{{ ch.src }}" width="{{ ch.width }}"></p>
<table border="0" cellspacing="0" cellpadding="6" width="100%"><tr><td bgcolor="{{ t.MUTED_ROW }}">
<b>{{ labels.how_to_read }}.</b> {{ ch.how_to_read }}</td></tr></table>
{% endfor %}

<h2 style="font-family:Georgia, 'DejaVu Serif', serif; font-weight:normal; letter-spacing:1px; color:{{ t.INK }}; font-size:14pt; page-break-before:always;">{{ labels.tables }}</h2>
<p style="color:{{ t.INK_SECONDARY }};">{{ labels.table_hint }}</p>
{% for tb in tables %}
<h3 style="font-size:11pt; color:{{ t.INK }};">{{ tb.title }}</h3>
{% if tb.note %}<p style="color:{{ t.INK_SECONDARY }};">{{ tb.note }}</p>{% endif %}
{% if tb.rows %}<table border="1" cellspacing="0" cellpadding="2" width="100%" style="font-size:7pt;">
<tr>{% for h in tb.headers %}<th bgcolor="{{ t.SAND }}" align="left">{{ h }}</th>{% endfor %}</tr>
{% for row in tb.rows %}<tr>{% for cell in row.cells %}<td{% if row.flag %} bgcolor="{{ t.FLAG_ROW }}"{% elif row.muted %} bgcolor="{{ t.MUTED_ROW }}"{% endif %}{% if row.numeric[loop.index0] %} align="right"{% endif %}>{{ cell }}</td>{% endfor %}</tr>
{% endfor %}</table>
{% else %}<p style="color:{{ t.INK_SECONDARY }};">{{ labels.no_rows }}</p>{% endif %}
{% endfor %}

<h2 style="font-family:Georgia, 'DejaVu Serif', serif; font-weight:normal; letter-spacing:1px; color:{{ t.INK }}; font-size:14pt; page-break-before:always;">{{ labels.glossary }}</h2>
{% for term in glossary %}<p><b>{{ term.term }}</b><br>{{ term.long }}</p>{% endfor %}
<p style="color:{{ t.BRONZE }}; letter-spacing:3px; font-size:8pt;">{{ app|upper }} · {{ version }} · CENTER FOR SOCIAL PSYCHOLOGY AND SOCIETY</p>
</body>
</html>
